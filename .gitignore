# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Amplify Gen 2 sandbox local state/cache.
.amplify/

# NOTE: amplify_outputs.json is intentionally NOT gitignored — a placeholder
# is committed so `npm run build` works on a fresh clone before any deploy.
# `ampx sandbox`/deploy overwrites it with the REAL backend config (API
# endpoint + apiKey). Before committing after a local sandbox run, check
# `git diff amplify_outputs.json` — don't push your personal sandbox's
# endpoint/key as if it were the shared placeholder.

